---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
---
<Base title="เกี่ยวกับเรา" description={`${SITE.name} คือเว็บรวมโปรเน็ตมือถือเติมเงิน ช่วยเลือกโปรให้ตรงกับการใช้งาน อัปเดตราคาทุกเดือน`}>
  <h1>เกี่ยวกับ {SITE.name}</h1>
  <p>{SITE.name} รวบรวมโปรเน็ตมือถือเติมเงินแบบไม่จำกัดปริมาณ และอธิบายว่าความเร็วแต่ละระดับใช้ทำอะไรได้ เพื่อให้คุณเลือกโปรที่พอดีกับการใช้งาน ไม่จ่ายเกินจำเป็น</p>
  <h2>เราได้รายได้จากอะไร</h2>
  <p>เมื่อคุณสมัครโปรผ่านรหัสบนเว็บนี้ เราอาจได้รับค่าแนะนำจากผู้ให้บริการ โดย<strong>ราคาที่คุณจ่ายเท่าเดิม</strong> เงินถูกหักจากยอดเงินในซิมของคุณโดยตรง เราไม่ขอข้อมูลส่วนตัว และไม่รับโอนเงินใด ๆ</p>
  <h2>ข้อสงวนสิทธิ์</h2>
  <p>เว็บไซต์นี้ไม่ใช่เว็บไซต์ทางการของ AIS ราคาและเงื่อนไขอาจเปลี่ยนแปลงโดยผู้ให้บริการ โปรดตรวจสอบราคาใน SMS ยืนยันทุกครั้ง หากพบข้อมูลผิด แจ้งเราได้ทันที</p>
  <p class="small">ข้อมูลอัปเดตล่าสุด {SITE.updated}</p>
</Base>

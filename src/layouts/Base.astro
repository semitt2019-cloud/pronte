---
import { SITE } from '../config';
import AppShell from '../components/AppShell.astro';

interface Props {
  title: string;
  description: string;
  schema?: object[];
}
const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | ${SITE.name}`;

const nav = [
  ['/', 'โปรทั้งหมด'],
  ['/ais-1-day/', 'รายวัน'],
  ['/ais-7-day/', '7 วัน'],
  ['/ais-30-day/', '30 วัน'],
  ['/chooser/', 'ช่วยเลือกโปร'],
  ['/ais-shortcodes/', 'เบอร์ลัด AIS'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="th_TH" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#8dc63f" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="โปรเน็ตสุดคุ้ม" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <header class="top">
    <div class="wrap top-in">
      <a href="/" class="logo">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><rect x="6" y="1.5" width="12" height="21" rx="2.8" fill="currentColor"/><rect x="7.6" y="4" width="8.8" height="15" rx="1.2" fill="#6aae2c"/><path d="M9.3 10.6a4 4 0 0 1 5.4 0M10.5 12.2a2.2 2.2 0 0 1 3 0" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><circle cx="12" cy="13.8" r=".7" fill="currentColor"/></svg>
        </span>
        {SITE.name}
      </a>
      <span class="upd"><i></i>อัปเดต {SITE.updated}</span>
    </div>
    <nav class="wrap nav" aria-label="เมนูหลัก">
      {nav.map(([href, label]) => (
        <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </header>

  <main class="wrap">
    <AppShell />
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <a href="/" class="logo">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><rect x="6" y="1.5" width="12" height="21" rx="2.8" fill="currentColor"/><rect x="7.6" y="4" width="8.8" height="15" rx="1.2" fill="#6aae2c"/><path d="M9.3 10.6a4 4 0 0 1 5.4 0M10.5 12.2a2.2 2.2 0 0 1 3 0" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><circle cx="12" cy="13.8" r=".7" fill="currentColor"/></svg>
        </span>
        {SITE.name}
      </a>
      <p>รวบรวมโปรเน็ตมือถือเติมเงิน ไม่อั้น ไม่ลดสปีด อัปเดตราคาทุกเดือน</p>
      <p class="flinks">
        <a href="/ais-shortcodes/">เบอร์ลัด AIS</a>
        <a href="/speed-guide/">ความเร็วเน็ตแต่ละระดับ</a>
        <a href="/chooser/">ช่วยเลือกโปร</a>
        <a href="/app/">ติดตั้งแอป</a>
        <a href="/about/">เกี่ยวกับเรา</a>
      </p>
      <p class="disc">
        เว็บไซต์นี้ไม่ใช่เว็บไซต์ทางการของ AIS ชื่อ AIS เป็นเครื่องหมายการค้าของเจ้าของ
        ราคาและเงื่อนไขอาจเปลี่ยนแปลงได้ ตรวจสอบราคาใน SMS ยืนยันก่อนสมัครทุกครั้ง
      </p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    --bg: #f7faf2;
    --card: #ffffff;
    --ink: #0e1710;
    --muted: #5f6b62;
    --line: #e3e8e0;
    --dark: #0a120c;
    --dark-2: #13221a;
    --lime: #8dc63f;        /* เขียวมะนาว */
    --lime-2: #b4e05a;
    --lime-ink: #3b7a12;    /* เขียวเข้มสำหรับตัวอักษรบนพื้นขาว */
    --lime-soft: #eef7e1;
    --gold: #d4b26a;
    --hot: #c2410c;
    --radius: 18px;
    --shadow: 0 1px 2px rgba(10, 18, 12, .04), 0 8px 24px -12px rgba(10, 18, 12, .18);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: 'Prompt', 'Noto Sans Thai', 'Leelawadee UI', Tahoma, system-ui, sans-serif;
    font-size: 16px; line-height: 1.7; font-weight: 400;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--lime-ink); }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 16px; }

  /* ---------- หัวเว็บ ---------- */
  .top {
    background: rgba(255,255,255,.92); backdrop-filter: saturate(1.4) blur(10px);
    color: var(--ink); position: sticky; top: 0; z-index: 10;
    border-bottom: 1px solid var(--line);
    box-shadow: 0 1px 0 rgba(141,198,63,.35), 0 6px 20px -16px rgba(60,110,20,.5);
  }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 58px; }
  .logo { font-weight: 600; font-size: 1.15rem; color: inherit; text-decoration: none; display: flex; align-items: center; gap: 10px; letter-spacing: .2px; }
  .mark {
    width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center;
    background: linear-gradient(140deg, var(--lime-2), var(--lime)); color: #fff;
    box-shadow: 0 6px 16px -6px rgba(110,170,40,.8);
  }
  .upd { font-size: .78rem; color: var(--muted); display: flex; align-items: center; gap: 6px; }
  .upd i { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 8px var(--lime); }
  .nav { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 12px; scrollbar-width: none; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a {
    flex: none; padding: 6px 14px; border-radius: 999px; color: var(--ink);
    text-decoration: none; font-size: .9rem; background: #f1f5ec; border: 1px solid transparent;
  }
  .nav a[aria-current='page'] { background: linear-gradient(140deg, var(--lime-2), var(--lime)); color: #fff; font-weight: 600; box-shadow: 0 4px 12px -6px rgba(110,170,40,.9); }

  /* ---------- เนื้อหา ---------- */
  main { padding-top: 24px; padding-bottom: 48px; }
  h1 { font-size: 1.75rem; line-height: 1.3; margin: 6px 0 10px; font-weight: 700; letter-spacing: -.2px; }
  h2 { font-size: 1.3rem; margin: 40px 0 14px; font-weight: 600; display: flex; align-items: center; gap: 10px; }
  h2::before { content: ''; width: 4px; height: 1.1em; border-radius: 4px; background: linear-gradient(var(--lime-2), var(--lime)); }
  h3 { font-size: 1.05rem; margin: 20px 0 8px; font-weight: 600; }
  .lead { color: var(--muted); margin: 0 0 18px; }
  .small { font-size: .85rem; color: var(--muted); }
  .note {
    background: var(--lime-soft); border: 1px solid #d9ecbf; border-radius: var(--radius);
    padding: 14px 18px; font-size: .97rem;
  }
  .note strong { color: var(--lime-ink); }
  ol, ul { padding-left: 22px; }

  .tbl { overflow-x: auto; border-radius: var(--radius); box-shadow: var(--shadow); }
  table { width: 100%; border-collapse: collapse; background: var(--card); font-size: .95rem; }
  th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { background: var(--lime-soft); color: var(--lime-ink); font-weight: 600; }
  tr:last-child td { border-bottom: 0; }
  code { background: var(--lime-soft); padding: 2px 8px; border-radius: 8px; font-size: .95em; font-family: ui-monospace, Menlo, Consolas, monospace; }

  .links { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; padding: 0; list-style: none; }
  .links a {
    display: block; background: var(--card); border: 1px solid var(--line); border-radius: 14px;
    padding: 12px 14px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow);
    transition: border-color .15s, transform .15s;
  }
  .links a:hover { border-color: var(--lime); transform: translateY(-1px); }

  /* ---------- ท้ายเว็บ ---------- */
  .foot { background: linear-gradient(180deg, #eef7e1, #e3f1cf); color: var(--ink); padding: 32px 0 40px; font-size: .92rem; }
  .foot .logo { color: var(--ink); margin-bottom: 8px; }
  .foot p { margin: 8px 0; }
  .flinks { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .flinks a { color: var(--lime-ink); text-decoration: none; }
  .disc { font-size: .8rem; color: var(--muted); border-top: 1px solid rgba(59,122,18,.15); padding-top: 14px; margin-top: 16px !important; }
</style>

---
// กล่องโปรเน็ต AIS ยอดนิยม (กดสมัครได้ทันที) — ใช้ในบทความหมวดความรู้เน็ต AIS
import { AIS, speedLabel } from '../data/ais';
import { ussd, telHref } from '../config';

interface Props { heading?: string; codes?: string[] }
const { heading = 'โปรเน็ต AIS ไม่อั้น ไม่ลดสปีด ที่คนเลือกบ่อย', codes = ['7721', '7724', '7629', '7790'] } = Astro.props;
const LABEL: Record<number, string> = { 1: '1 วัน', 2: '2 วัน', 3: '3 วัน', 7: '7 วัน', 30: '30 วัน' };
const list = codes.map((c) => AIS.find((p) => p.code === c)).filter(Boolean) as typeof AIS;
---
<aside class="gc" aria-label="โปรเน็ต AIS ยอดนิยม">
  <span class="tag">📶 โปรเน็ต AIS เติมเงิน</span>
  <p class="h">{heading}</p>
  <div class="grid">
    {list.map((p) => (
      <div class="c dialbox">
        <i>{LABEL[p.days] ?? `${p.days} วัน`}</i>
        <b>{p.price}฿<small>/{p.days} วัน</small></b>
        <span>ไม่อั้น {speedLabel(p.mbps)} · {p.net}</span>
        <code class="dial">{ussd(p.code)}</code>
        <a class="go" href={telHref(p.code)} data-pkg={p.code}>กดสมัคร</a>
      </div>
    ))}
  </div>
  <a class="more" href="/chooser/">ไม่แน่ใจว่าโปรไหนเหมาะ? ช่วยเลือกโปรใน 3 คำถาม →</a>
</aside>

<style>
  .gc { margin: 26px 0; padding: 18px; border-radius: 20px; background: linear-gradient(120deg, #eef7e1, #e2f2c9); border: 1px solid #c8e39b; }
  .tag { font-size: .78rem; font-weight: 600; color: var(--lime-ink); }
  .h { margin: 4px 0 12px; font-size: 1.15rem; font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
  .c { background: #fff; border-radius: 14px; padding: 10px 8px; text-align: center; display: grid; gap: 2px; box-shadow: var(--shadow); }
  .c i { font-style: normal; font-size: .72rem; font-weight: 600; color: #8a5a00; }
  .c b { font-size: 1.3rem; color: var(--lime-ink); }
  .c b small { font-size: .75rem; color: var(--muted); font-weight: 500; }
  .c span { font-size: .8rem; }
  .c code { color: var(--muted); background: transparent; padding: 2px 0; font-size: .78rem; }
  .go { margin-top: 6px; padding: 7px 0; border-radius: 10px; font-weight: 600; font-size: .9rem; color: #fff; text-decoration: none;
    background: linear-gradient(140deg, var(--lime-2), var(--lime) 60%, #6aae2c); }
  .more { display: inline-block; margin-top: 12px; font-weight: 600; color: var(--lime-ink); }
</style>

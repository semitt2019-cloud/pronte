---
import Base from '../layouts/Base.astro';
import PkgList from '../components/PkgList.astro';
import Faq from '../components/Faq.astro';
import TripAd from '../components/TripAd.astro';
import { LIST_PAGES, type ListPage } from '../data/pages';
import { TRIP_PAGES } from '../data/affiliates';
import { faqSchema, offersSchema, breadcrumb } from '../lib/seo';
import { SITE } from '../config';

export function getStaticPaths() {
  return LIST_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ListPage };
const items = page.items();
const related = LIST_PAGES.filter((p) => p.slug !== page.slug);
const MORE: Record<string, [string, string][]> = {
  'ais-1-day': [
    ['แพ็กเน็ตรายวัน AIS อธิบายทีละราคา', '/blog/ais-daily-pack/'],
    ['สมัครเน็ต AIS กดอะไร', '/blog/subscribe-ais-internet/'],
  ],
  'ais-2-day': [
    ['เน็ต AIS เติมเงิน เลือกตามจำนวนวัน', '/blog/ais-prepaid-internet/'],
    ['โปรเน็ตไปเที่ยวในประเทศ', '/travel/'],
  ],
  'ais-3-day': [
    ['โปรเน็ตไปเที่ยว', '/travel/'],
    ['เน็ตไม่อั้นไม่ลดสปีด AIS', '/blog/ais-unlimited-fixed/'],
  ],
  'ais-7-day': [
    ['เน็ตรายสัปดาห์ AIS', '/blog/ais-weekly-pack/'],
    ['สมัครเน็ต AIS กดอะไร', '/blog/subscribe-ais-internet/'],
  ],
  'ais-30-day': [
    ['เน็ตรายเดือน AIS เติมเงิน', '/blog/ais-monthly-prepaid/'],
    ['ซิมใหม่ AIS กับโปร 30 วัน', '/blog/ais-new-sim-pack/'],
  ],
  'ais-under-100': [
    ['แพ็กเน็ตรายวัน AIS', '/blog/ais-daily-pack/'],
    ['เน็ต AIS เติมเงิน', '/blog/ais-prepaid-internet/'],
  ],
  'ais-tiktok': [
    ['เน็ตไม่อั้นไม่ลดสปีด AIS', '/blog/ais-unlimited-fixed/'],
    ['ความเร็วเน็ตแต่ละระดับ', '/speed-guide/'],
  ],
  'ais-youtube': [
    ['เน็ตรายเดือน AIS เติมเงิน', '/blog/ais-monthly-prepaid/'],
    ['ความเร็วเน็ตแต่ละระดับ', '/speed-guide/'],
  ],
};
const more = MORE[page.slug] ?? [];
const schema = [
  breadcrumb([['หน้าแรก', '/'], [page.title, `/${page.slug}/`]]),
  offersSchema(page.title, items),
  faqSchema(page.faq),
];
---
<Base title={page.title} description={page.description} schema={schema}>
  <h1>{page.title}</h1>
  <p class="lead">อัปเดตราคา {SITE.updated} · {items.length} โปร</p>
  <p>{page.intro}</p>
  <p class="note"><strong>แนะนำ:</strong> {page.pick}</p>

  <h2>โปรทั้งหมดในหมวดนี้</h2>
  <PkgList items={items} />

  <h2>วิธีสมัคร</h2>
  <ol>
    <li>เช็กเงินในซิมให้พอกับราคาโปร (กด <code>*121#</code>)</li>
    <li>กดปุ่ม "กดสมัคร" หรือกดรหัสบนแป้นโทรศัพท์แล้วโทรออก</li>
    <li>รอ SMS ยืนยัน ตรวจราคาให้ตรง แล้วเริ่มใช้งานได้ทันที</li>
  </ol>

  {TRIP_PAGES.includes(page.slug) && <TripAd />}

  <Faq items={page.faq} />

  {more.length > 0 && (
    <>
      <h2>อ่านเพิ่ม</h2>
      <ul class="links">
        {more.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </>
  )}

  <h2>โปรเน็ตหมวดอื่น</h2>
  <ul class="links">
    {related.map((p) => <li><a href={`/${p.slug}/`}>{p.keyword}</a></li>)}
  </ul>
</Base>

---
import Base from '../layouts/Base.astro';
import PkgList from '../components/PkgList.astro';
import Faq from '../components/Faq.astro';
import { AIS, byDays } from '../data/ais';
import { LIST_PAGES } from '../data/pages';
import { SALES } from '../data/sales';
import { faqSchema, offersSchema } from '../lib/seo';
import { POSTS, KEYWORD_GUIDES } from '../lib/blog';
import { SITE } from '../config';

const popular = AIS.filter((p) => p.popular).sort((a, b) => a.days - b.days || a.price - b.price);
const groups: [number, string][] = [[1, 'ais-1-day'], [2, 'ais-2-day'], [3, 'ais-3-day'], [7, 'ais-7-day'], [30, 'ais-30-day']];
const minPrice = Math.min(...AIS.map((p) => p.price));

const title = `โปรเน็ต AIS ไม่อั้น ไม่ลดสปีด ล่าสุด ${SITE.updated}`;
const description = 'รวมโปรเน็ต AIS เติมเงิน ไม่จำกัดปริมาณ ไม่ลดสปีด ทั้งรายวัน 7 วัน และ 30 วัน ราคาเริ่ม 24 บาท พร้อมรหัสกดสมัครและวิธีเลือกความเร็วให้เหมาะกับการใช้งาน';
const guides = KEYWORD_GUIDES.flatMap((slug) => {
  const post = POSTS.find((p) => p.slug === slug);
  return post ? [post] : [];
});
const faq: [string, string][] = [
  ['โปรเน็ต AIS เติมเงินเริ่มต้นกี่บาท?', `แพ็กในหน้านี้เริ่ม ${minPrice} บาท ราคารวมภาษีแล้ว ควรเปรียบเทียบความเร็ว ระยะเวลา และสิทธิ์สมัครของหมายเลขก่อนเลือกแพ็ก`],
  ['ควรเลือกโปรรายวันหรือ 30 วัน?', 'ใช้ชั่วคราวเลือกแพ็ก 1–3 วัน ใช้ต่อเนื่องหนึ่งสัปดาห์ดูแพ็ก 7 วัน หากใช้ทุกวันให้เทียบแพ็ก 30 วันจากงบรวมและความเร็วที่ต้องการ ไม่ควรดูเฉพาะราคาเฉลี่ยต่อวัน'],
  ['เน็ตไม่อั้นไม่ลดสปีดคืออะไร?', 'ใช้ได้ไม่จำกัดปริมาณที่ความเร็วคงที่ตามโปรตลอดอายุ เช่น 4 Mbps ก็ได้ 4 Mbps ตลอด ไม่ถูกลดลงเมื่อใช้เยอะ'],
  ['ควรเลือกความเร็วเท่าไหร่?', 'แชตและ Facebook ใช้ 1–2 Mbps, TikTok และ YouTube 720p ใช้ 4 Mbps, ไลฟ์สดหรือแชร์ฮอตสปอตใช้ 6 Mbps ขึ้นไป'],
  ['สมัครแล้วเงินถูกหักจากไหน?', 'หักจากยอดเงินในซิม AIS เติมเงินของคุณโดยตรง ไม่ต้องโอนเงินหรือให้ข้อมูลส่วนตัวใด ๆ'],
  ['เช็กโปรที่ใช้อยู่ยังไง?', 'กด *121*32# แล้วโทรออก ระบบจะส่งรายละเอียดโปรที่ใช้อยู่ทาง SMS'],
];
---
<Base title={`โปรเน็ต AIS เติมเงิน รายวัน 7 วัน 30 วัน | เริ่ม ${minPrice} บาท`} description={description} schema={[
  offersSchema('โปรเน็ต AIS ยอดนิยม', popular),
  faqSchema(faq),
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, inLanguage: 'th-TH' },
]}>
  <section class="hero">
    <span class="eyebrow">AIS เติมเงิน · {SITE.updated}</span>
    <h1>โปรเน็ต AIS <em>ไม่อั้น ไม่ลดสปีด</em><br />ล่าสุด {SITE.updated}</h1>
    <p>เน็ต 4G / 5G ไม่จำกัดปริมาณ เริ่มต้น 24 บาท กดรหัสสมัครได้ทันที ไม่ต้องโหลดแอป</p>
    <div class="chips">
      <span>ไม่จำกัดปริมาณ</span><span>ไม่ลดสปีด</span><span>ราคารวมภาษี</span>
    </div>
    <a class="cta" href="/chooser/">ช่วยเลือกโปรที่คุ้มที่สุด →</a>
  </section>

  <nav class="package-jumps" aria-label="เลือกโปรเน็ต AIS ตามจำนวนวัน">
    <a href="#popular">โปรยอดนิยม</a>
    {groups.map(([d]) => <a href={`#ais-${d}-day`}>{d} วัน</a>)}
  </nav>

  <a class="newsim" href="/ais-new-sim/">
    <span class="ns-tag">เปิดซิมใหม่ AIS</span>
    <b>เปิดซิมใหม่ สมัครแพ็กเสริมเน็ต 30 วัน เน็ตรวมสูงสุด 100GB มีแพ็กสายเกม และโทรฟรีทุกเครือข่าย</b>
    <span class="ns-go">ดูแพ็ก 200–350 บาท →</span>
  </a>

  <a class="newsim style" href="/ais-my-style/">
    <span class="ns-tag">แพ็ก MY STYLE</span>
    <b>มีแพ็กเน็ต 250–350 บาทแล้ว เลือกความพิเศษเพิ่มได้ 1 อย่าง จ่ายเพิ่ม 29 บาท/เดือน</b>
    <span class="ns-go">ดู ReelShort, โซเชียล, เกม, Viu, WeTV →</span>
  </a>

  <a class="newsim stu" href="/students/">
    <span class="ns-tag">🎓 นักเรียน นักศึกษา</span>
    <b>ใช้เน็ตเยอะ เรียนออนไลน์ ดูคลิป เล่นเกม? ดูโปรที่เหมาะกับนักเรียน เริ่มวันละไม่ถึง 14 บาท</b>
    <span class="ns-go">ดูโปรเน็ตนักเรียน →</span>
  </a>

  <a class="newsim game" href="/games/">
    <span class="ns-tag">🎮 สายเกม</span>
    <b>เล่น ROV, Free Fire, PUBG ทุกวัน? ดูโปรเน็ตไม่อั้นและแพ็กเน็ตเล่นเกมไม่จำกัด</b>
    <span class="ns-go">ดูโปรเน็ตเล่นเกม →</span>
  </a>

  <a class="newsim trip" href="/travel/">
    <span class="ns-tag">🧳 ไปเที่ยว</span>
    <b>เที่ยววันหยุดยาว 3 วัน เน็ต 5G ไม่อั้น 105 บาท ไม่ต้องกลัวเน็ตหมดกลางทริป</b>
    <span class="ns-go">ดูโปรเน็ตไปเที่ยว →</span>
  </a>

  <h2 id="popular">โปรเน็ต AIS ยอดนิยม</h2>
  <PkgList items={popular} />

  {groups.map(([d, slug]) => (
    <section>
      <h2 id={`ais-${d}-day`}>โปรเน็ต AIS {d} วัน</h2>
      <PkgList items={byDays(d)} />
      <p><a href={`/${slug}/`}>ดูรายละเอียดและคำแนะนำโปร {d} วัน →</a></p>
    </section>
  ))}

  <section aria-labelledby="choose-package">
    <h2 id="choose-package">เลือกโปรเน็ต AIS ให้เหมาะกับการใช้งาน</h2>
    <p>เริ่มจากจำนวนวันที่ต้องใช้และงบรวม แล้วค่อยเลือกความเร็ว แพ็กที่มีเน็ตเต็มสปีดแถมกับแพ็กความเร็วคงที่อาจมีเงื่อนไขต่างกัน ควรอ่านรายละเอียดก่อนกดสมัคร</p>
    <ul class="links">
      <li>ใช้ชั่วคราว: <a href="/ais-1-day/">โปรรายวัน</a> หรือ <a href="/ais-3-day/">โปร 3 วัน</a> สำหรับเติมเน็ตช่วงสั้น</li>
      <li>ใช้ต่อเนื่อง: เปรียบเทียบ <a href="/ais-7-day/">โปร 7 วัน</a> กับ <a href="/ais-30-day/">โปร 30 วัน</a> จากยอดจ่ายรวมและความเร็ว</li>
      <li>ยังเลือกไม่ถูก: ใช้ <a href="/chooser/">ตัวช่วยเลือกโปรตามงบและการใช้งาน</a> หรืออ่าน <a href="/speed-guide/">คำแนะนำเรื่องความเร็วเน็ต</a></li>
    </ul>
    <p>ก่อนสมัคร: เช็กแพ็กเดิมและยอดเงิน เลือกซิมให้ถูก แล้วรอ SMS ยืนยันจาก AIS ก่อนใช้เน็ต สิทธิ์สมัครขึ้นกับหมายเลขและเงื่อนไขของแพ็ก ความเร็วจริงขึ้นกับสัญญาณ พื้นที่ อุปกรณ์ และเครือข่าย</p>
    <p>หน้านี้รวมแพ็กเสริมเติมเงิน หากต้องการเปิดหมายเลขใหม่ให้ดู <a href="/ais-new-sim/">แพ็กสำหรับเปิดซิมใหม่ AIS</a> และตรวจสิทธิ์เฉพาะหมายเลขผ่าน <a href="https://www.ais.th/consumers/lifestyle/myais3">myAIS ของ AIS</a></p>
  </section>

  <h2>รายละเอียดโปรแนะนำ</h2>
  <ul class="links">
    {SALES.map((x) => <li><a href={`/pro/${x.slug}/`}>{x.keyword}</a></li>)}
  </ul>

  <h2>คู่มือเลือกโปรเน็ต</h2>
  <ul class="links">
    {guides.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.meta.keyword}</a></li>)}
  </ul>

  <h2>เลือกโปรตามการใช้งาน</h2>
  <ul class="links">
    {LIST_PAGES.map((p) => <li><a href={`/${p.slug}/`}>{p.keyword}</a></li>)}
    <li><a href="/speed-guide/">ความเร็วแต่ละระดับใช้ทำอะไรได้</a></li>
  </ul>

  <Faq items={faq} />
</Base>

<style>
  .package-jumps { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0; }
  .package-jumps a { padding:8px 14px; border:1px solid var(--line); border-radius:999px; color:var(--lime-ink); text-decoration:none; background:var(--card); }
  .hero .eyebrow, .hero .chips span { color:#173d0d; background:rgba(255,255,255,.65); }
  .hero p { color:#173d0d !important; }
  .hero h1 { text-shadow:none !important; }
  h2[id] { scroll-margin-top:90px; }
  .hero {
    position: relative; overflow: hidden; color: #173d0d; border-radius: 24px;
    padding: 32px 24px 28px; margin-top: 4px;
    background:
      radial-gradient(90% 80% at 100% 0%, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 60%),
      linear-gradient(135deg, #ceef69 0%, #a8df43 45%, #86c937 100%);
    box-shadow: 0 22px 40px -22px rgba(79,158,36,.75);
  }
  .hero::after {
    content: ''; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.35); box-shadow: 0 0 0 30px rgba(255,255,255,.08), 0 0 0 60px rgba(255,255,255,.05);
  }
  .eyebrow { font-size: .78rem; letter-spacing: 1.5px; color: #fff7d6; display: inline-block; background: rgba(255,255,255,.18); padding: 3px 12px; border-radius: 999px; text-transform: uppercase; font-weight: 500; }
  .hero h1 { font-size: 2rem; margin: 12px 0 12px; position: relative; z-index: 1; text-shadow: 0 2px 10px rgba(40,90,10,.25); }
  .hero h1 em { font-style: normal; color: #244b0c; }
  .hero p { color: rgba(255,255,255,.95); margin: 0 0 16px; max-width: 520px; position: relative; z-index: 1; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .chips span { font-size: .82rem; padding: 4px 12px; border-radius: 999px; color: #fff; background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.4); }
  .cta {
    display: inline-block; background: #fff; color: var(--lime-ink);
    font-weight: 600; text-decoration: none; padding: 12px 22px; border-radius: 14px;
    box-shadow: 0 10px 24px -10px rgba(30,70,10,.6); position: relative; z-index: 1;
  }
  .newsim {
    display: grid; gap: 4px; margin-top: 16px; padding: 14px 18px; border-radius: 18px; text-decoration: none; color: var(--ink);
    background: linear-gradient(120deg, #fff8e1, #fdf0c8); border: 1px solid #f5d48a; box-shadow: var(--shadow);
  }
  .ns-tag { font-size: .75rem; font-weight: 600; color: #8a5a00; }
  .newsim b { font-weight: 600; }
  .ns-go { color: var(--lime-ink); font-weight: 500; font-size: .92rem; }
  .newsim.style { margin-top: 10px; background: linear-gradient(120deg, #e7f6fb, #d4f0e8); border-color: #b7e0ea; }
  .newsim.style .ns-tag { color: #0b6e75; }
  .newsim.stu { margin-top: 10px; background: linear-gradient(120deg, #eef7e1, #e2f2c9); border-color: #c8e39b; }
  .newsim.stu .ns-tag { color: var(--lime-ink); }
  .newsim.game { margin-top: 10px; background: linear-gradient(120deg, #eef1f6, #e2e8f2); border-color: #c5cfdf; }
  .newsim.game .ns-tag { color: #33415c; }
  .newsim.trip { margin-top: 10px; background: linear-gradient(120deg, #e3f5f8, #d3ecf3); border-color: #a9d8e4; }
  .newsim.trip .ns-tag { color: #0b5c73; }
  @media (min-width: 720px) { .hero { padding: 48px 44px 40px; } .hero h1 { font-size: 2.6rem; } }
</style>

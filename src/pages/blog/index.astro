---
// หน้ารวมบทความ
import Base from '../../layouts/Base.astro';
import NewSimCta from '../../components/NewSimCta.astro';
import { POSTS, thaiDate, CATEGORIES, catOf } from '../../lib/blog';
import { breadcrumb } from '../../lib/seo';
import { SITE } from '../../config';

const title = 'บทความโปรเน็ต AIS เปิดซิมใหม่ และเน็ตสำหรับนักเรียน นักศึกษา';
const groups = (['students', 'newsim'] as const).map((k) => ({ key: k, ...CATEGORIES[k], posts: POSTS.filter((p) => catOf(p) === k) })).filter((g) => g.posts.length);
const description = 'รวมบทความโปรเน็ต AIS เรื่องเปิดซิมใหม่ ลงทะเบียน แก้ปัญหาซิม และบทความสำหรับนักเรียน นักศึกษา เรียนออนไลน์ใช้เน็ตเท่าไร ประหยัดเน็ตยังไง อ่านง่าย ทำตามได้ทันที';
const schema = [
  breadcrumb([['หน้าแรก', '/'], ['บทความ', '/blog/']]),
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: title,
    itemListElement: POSTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/blog/${p.slug}/`, SITE.url).href, name: p.meta.h1 })),
  },
];
---
<Base title={title} description={description} schema={schema}>
  <nav class="crumb" aria-label="breadcrumb"><a href="/">หน้าแรก</a> › <span>บทความ</span></nav>
  <section class="hero">
    <h1>บทความโปรเน็ต AIS</h1>
    <p>ทุกเรื่องที่ต้องรู้ ตั้งแต่เปิดซิมใหม่ จนถึงใช้เน็ตให้คุ้มสำหรับนักเรียน นักศึกษา</p>
  </section>

  <nav class="chips" aria-label="หมวดบทความ">
    {groups.map((g) => <a href={`#${g.key}`}>{g.key === 'students' ? '🎓 ' : ''}{g.label} <small>{g.posts.length}</small></a>)}
  </nav>

  <a class="stu" href="/students/">
    <span>🎓 สำหรับนักเรียน นักศึกษา</span>
    <b>โปรเน็ตนักเรียน เรียนออนไลน์ ดูคลิป เล่นเกม เริ่มวันละไม่ถึง 14 บาท</b>
    <em>ดูโปรที่เหมาะ →</em>
  </a>

  {groups.map((g) => (
    <section id={g.key} class="grp">
      <h2>{g.label}</h2>
      <div class="list">
        {g.posts.map((p, i) => (
          <a class="post" href={`/blog/${p.slug}/`}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <b>{p.meta.h1}</b>
              <p>{p.meta.description}</p>
              <small>{thaiDate(p.meta.updated ?? p.meta.date)}</small>
            </div>
          </a>
        ))}
      </div>
      <a class="hub" href={g.hub}>ไปหน้า {g.hubLabel} →</a>
    </section>
  ))}

  <NewSimCta />
</Base>

<style>
  .crumb { font-size: .85rem; color: var(--muted); margin: 10px 0 6px; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .hero { border-radius: 22px; padding: 26px 22px; color: #fff;
    background: radial-gradient(90% 80% at 100% 0%, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 60%), linear-gradient(135deg, #a6d84e 0%, #7fbf35 45%, #4f9e24 100%); }
  .hero h1 { margin: 0 0 8px; font-size: 1.8rem; }
  .hero p { margin: 0; }
  .list { display: grid; gap: 10px; margin-top: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .chips a { background: var(--card); border: 1px solid var(--line); padding: 8px 14px; border-radius: 999px; text-decoration: none; color: var(--ink); font-weight: 500; }
  .chips small { color: var(--muted); }
  .stu { display: grid; gap: 4px; margin-top: 14px; padding: 14px 18px; border-radius: 18px; text-decoration: none; color: var(--ink); background: linear-gradient(120deg, #eef7e1, #e2f2c9); border: 1px solid #c8e39b; }
  .stu span { font-size: .78rem; font-weight: 600; color: var(--lime-ink); }
  .stu em { font-style: normal; color: var(--lime-ink); font-weight: 600; font-size: .92rem; }
  .grp { scroll-margin-top: 130px; }
  .hub { display: inline-block; margin-top: 10px; font-weight: 600; }
  .post { display: flex; gap: 14px; background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 16px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow); }
  .post:hover { border-color: var(--lime); }
  .n { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-weight: 700; color: #fff; background: linear-gradient(140deg, var(--lime-2), var(--lime)); }
  .post b { font-size: 1.05rem; }
  .post p { margin: 4px 0; color: var(--muted); font-size: .9rem; }
  .post small { color: var(--muted); font-size: .78rem; }
</style>

---
import Base from '../layouts/Base.astro';
import { breadcrumb } from '../lib/seo';

const title = 'รวมเบอร์ลัด AIS เช็กเงิน เช็กโปร เปิด-ปิดเน็ต';
const description = 'รวมรหัสลัด AIS ที่ใช้บ่อย เช็กยอดเงิน เช็กเบอร์ตัวเอง เช็กโปรเน็ตที่ใช้อยู่ เปิดและปิดสัญญาณเน็ต กดโทรออกได้ทันที';
const codes: [string, string][] = [
  ['เช็กยอดเงินคงเหลือ', '*121#'],
  ['เช็กเบอร์ตัวเอง', '*545#'],
  ['เช็กโปรเน็ตที่ใช้อยู่', '*121*32#'],
  ['ปิดสัญญาณเน็ต', '*129*1#'],
  ['เปิดสัญญาณเน็ต', '*129*2#'],
  ['ติดต่อ AIS Call Center', '1175'],
];
---
<Base title={title} description={description} schema={[breadcrumb([['หน้าแรก', '/'], [title, '/ais-shortcodes/']])]}>
  <h1>{title}</h1>
  <p class="lead">กดที่รหัสเพื่อโทรออกได้ทันทีจากมือถือ</p>
  <div class="tbl">
    <table>
      <thead><tr><th>ใช้ทำอะไร</th><th>กดรหัส</th></tr></thead>
      <tbody>
        {codes.map(([label, c]) => (
          <tr><td>{label}</td><td><a href={'tel:' + c.replace(/#/g, '%23')}><code>{c}</code></a></td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small">รหัสอาจเปลี่ยนแปลงตามประกาศของผู้ให้บริการ หากใช้ไม่ได้ ติดต่อ 1175</p>
  <p><a href="/">ดูโปรเน็ต AIS ทั้งหมด →</a></p>
</Base>

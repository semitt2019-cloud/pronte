---
import Base from '../layouts/Base.astro';
import PkgList from '../components/PkgList.astro';
import Faq from '../components/Faq.astro';
import { AIS, byDays } from '../data/ais';
import { LIST_PAGES } from '../data/pages';
import { faqSchema, offersSchema } from '../lib/seo';
import { SITE } from '../config';

const popular = AIS.filter((p) => p.popular).sort((a, b) => a.days - b.days || a.price - b.price);
const groups: [number, string][] = [[1, 'ais-1-day'], [2, 'ais-2-day'], [3, 'ais-3-day'], [7, 'ais-7-day'], [30, 'ais-30-day']];

const title = `โปรเน็ต AIS ไม่อั้น ไม่ลดสปีด ล่าสุด ${SITE.updated}`;
const description = 'รวมโปรเน็ต AIS เติมเงิน ไม่จำกัดปริมาณ ไม่ลดสปีด ทั้งรายวัน 7 วัน และ 30 วัน ราคาเริ่ม 24 บาท พร้อมรหัสกดสมัครและวิธีเลือกความเร็วให้เหมาะกับการใช้งาน';
const faq: [string, string][] = [
  ['เน็ตไม่อั้นไม่ลดสปีดคืออะไร?', 'ใช้ได้ไม่จำกัดปริมาณที่ความเร็วคงที่ตามโปรตลอดอายุ เช่น 4 Mbps ก็ได้ 4 Mbps ตลอด ไม่ถูกลดลงเมื่อใช้เยอะ'],
  ['ควรเลือกความเร็วเท่าไหร่?', 'แชตและ Facebook ใช้ 1–2 Mbps, TikTok และ YouTube 720p ใช้ 4 Mbps, ไลฟ์สดหรือแชร์ฮอตสปอตใช้ 6 Mbps ขึ้นไป'],
  ['สมัครแล้วเงินถูกหักจากไหน?', 'หักจากยอดเงินในซิม AIS เติมเงินของคุณโดยตรง ไม่ต้องโอนเงินหรือให้ข้อมูลส่วนตัวใด ๆ'],
  ['เช็กโปรที่ใช้อยู่ยังไง?', 'กด *121*32# แล้วโทรออก ระบบจะส่งรายละเอียดโปรที่ใช้อยู่ทาง SMS'],
];
---
<Base title={title} description={description} schema={[offersSchema('โปรเน็ต AIS ยอดนิยม', popular), faqSchema(faq)]}>
  <section class="hero">
    <span class="eyebrow">AIS เติมเงิน · {SITE.updated}</span>
    <h1>โปรเน็ต AIS <em>ไม่อั้น ไม่ลดสปีด</em><br />ล่าสุด {SITE.updated}</h1>
    <p>เน็ต 4G / 5G ไม่จำกัดปริมาณ เริ่มต้น 24 บาท กดรหัสสมัครได้ทันที ไม่ต้องโหลดแอป</p>
    <div class="chips">
      <span>ไม่จำกัดปริมาณ</span><span>ไม่ลดสปีด</span><span>ราคารวมภาษี</span>
    </div>
    <a class="cta" href="/chooser/">ช่วยเลือกโปรที่คุ้มที่สุด →</a>
  </section>

  <h2>โปรยอดนิยม</h2>
  <PkgList items={popular} />

  {groups.map(([d, slug]) => (
    <section>
      <h2>โปรเน็ต AIS {d} วัน</h2>
      <PkgList items={byDays(d)} />
      <p><a href={`/${slug}/`}>ดูรายละเอียดและคำแนะนำโปร {d} วัน →</a></p>
    </section>
  ))}

  <h2>เลือกโปรตามการใช้งาน</h2>
  <ul class="links">
    {LIST_PAGES.map((p) => <li><a href={`/${p.slug}/`}>{p.keyword}</a></li>)}
    <li><a href="/speed-guide/">ความเร็วแต่ละระดับใช้ทำอะไรได้</a></li>
  </ul>

  <Faq items={faq} />
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; color: #fff; border-radius: 24px;
    padding: 32px 24px 28px; margin-top: 4px;
    background:
      radial-gradient(90% 80% at 100% 0%, rgba(255,255,255,.35) 0%, rgba(255,255,255,0) 60%),
      linear-gradient(135deg, #a6d84e 0%, #7fbf35 45%, #4f9e24 100%);
    box-shadow: 0 22px 40px -22px rgba(79,158,36,.75);
  }
  .hero::after {
    content: ''; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.35); box-shadow: 0 0 0 30px rgba(255,255,255,.08), 0 0 0 60px rgba(255,255,255,.05);
  }
  .eyebrow { font-size: .78rem; letter-spacing: 1.5px; color: #fff7d6; display: inline-block; background: rgba(255,255,255,.18); padding: 3px 12px; border-radius: 999px; text-transform: uppercase; font-weight: 500; }
  .hero h1 { font-size: 2rem; margin: 12px 0 12px; position: relative; z-index: 1; text-shadow: 0 2px 10px rgba(40,90,10,.25); }
  .hero h1 em { font-style: normal; color: #fff6c2; }
  .hero p { color: rgba(255,255,255,.95); margin: 0 0 16px; max-width: 520px; position: relative; z-index: 1; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .chips span { font-size: .82rem; padding: 4px 12px; border-radius: 999px; color: #fff; background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.4); }
  .cta {
    display: inline-block; background: #fff; color: var(--lime-ink);
    font-weight: 600; text-decoration: none; padding: 12px 22px; border-radius: 14px;
    box-shadow: 0 10px 24px -10px rgba(30,70,10,.6); position: relative; z-index: 1;
  }
  @media (min-width: 720px) { .hero { padding: 48px 44px 40px; } .hero h1 { font-size: 2.6rem; } }
</style>
